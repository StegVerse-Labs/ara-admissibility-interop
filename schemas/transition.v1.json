{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/ara-admissibility-interop/schemas/transition.v1.json",
  "title": "StegGate Governed Transition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","transition_id","subject","authority_ref","intent_ref","candidate_ref","target","profile_ref","evidence_refs"],
  "properties": {
    "schema_version": {"const":"steggate.transition.v1"},
    "transition_id": {"type":"string","minLength":1},
    "subject": {"type":"object","additionalProperties":false,"required":["id","binding_profile"],"properties":{"id":{"type":"string","minLength":1},"binding_profile":{"type":"string","minLength":1}}},
    "authority_ref": {"type":"string","minLength":1},
    "intent_ref": {"type":"string","minLength":1},
    "candidate_ref": {"type":"string","minLength":1},
    "target": {"type":"object","additionalProperties":false,"required":["id","kind"],"properties":{"id":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1}}},
    "profile_ref": {"type":"string","minLength":1},
    "evidence_refs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "recipient": {"type":"object","additionalProperties":false,"properties":{"subject":{"type":"string","minLength":1},"binding_profile":{"type":"string","minLength":1},"attribute_evidence_refs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"attribute_asserted_at":{"type":"string","format":"date-time"},"attribute_max_age":{"type":"string","minLength":1}},"required":["subject","binding_profile"]},
    "audience_ref": {"type":"string","minLength":1},
    "sink": {"type":"object","additionalProperties":false,"required":["id","modality","coverage_class","exclusivity"],"properties":{"id":{"type":"string","minLength":1},"modality":{"enum":["text","image","audio","video","notification","tts","export","other"]},"coverage_class":{"enum":["pre_admitted","frontier_admitted","attested_only","ungoverned"]},"exclusivity":{"enum":["attested_single","claimed_single","shared","unknown"]},"re_disclosure_controls":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
    "claimed_lineage": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["predecessor_ref","dimensions"],"properties":{"predecessor_ref":{"type":"string","minLength":1},"dimensions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["identity","authority","intent","data","custody","service","instance"]}}}}},
    "lineage_claim_state": {"enum":["NONE","CLAIMED"]},
    "atomicity": {"enum":["atomic","partial_possible"]},
    "reversibility": {"enum":["reversible","compensable","irreversible"]},
    "decision_disclosure_policy": {"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"enum":["acknowledge","neither_confirm_nor_deny","silent"]},"recipient_visible_reason":{"type":"string"},"timing_profile":{"type":"string"}}}
  },
  "allOf": [
    {"if":{"required":["sink"]},"then":{"anyOf":[{"required":["recipient"]},{"required":["audience_ref"]}]}},
    {"if":{"properties":{"lineage_claim_state":{"const":"CLAIMED"}},"required":["lineage_claim_state"]},"then":{"required":["claimed_lineage"]}}
  ]
}
