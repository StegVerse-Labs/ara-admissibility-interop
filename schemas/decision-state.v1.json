{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/ara-admissibility-interop/schemas/decision-state.v1.json",
  "title": "StegGate Decision State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_state_id",
    "transition_id",
    "candidate_hash",
    "evaluated_at",
    "evidence_refs",
    "authority_refs",
    "policy_refs",
    "predicate_results",
    "disposition",
    "reason_codes",
    "commit_state",
    "observation_state",
    "reconciliation_state"
  ],
  "properties": {
    "schema_version": {"const": "steggate.decision-state.v1"},
    "decision_state_id": {"type": "string", "minLength": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "candidate_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "validity_interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "not_before": {"type": ["string", "null"], "format": "date-time"},
        "not_after": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authority_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "policy_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "predicate_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predicate_id", "result"],
        "properties": {
          "predicate_id": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]},
          "evidence_ref": {"type": "string", "minLength": 1},
          "reason_code": {"type": "string", "minLength": 1}
        }
      }
    },
    "obligations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolved_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "disposition": {"enum": ["ALLOW", "DENY", "REVIEW", "FAIL_CLOSED"]},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "topology": {"enum": ["INLINE_TERMINATING_PROXY", "SPLIT_ADMISSION_EXTERNAL_COMMIT", "DEFERRED_HUMAN_APPROVAL", "OTHER"]},
    "approval_ref": {"type": ["string", "null"]},
    "admission_token_ref": {"type": ["string", "null"]},
    "admission_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "commit_state": {"enum": ["NOT_ATTEMPTED", "COMMIT_ATTEMPTED", "COMMITTED", "NOT_COMMITTED", "COMMIT_UNKNOWN"]},
    "executor_invoked": {"type": "boolean"},
    "target_ref": {"type": ["string", "null"]},
    "observation_state": {"enum": ["NOT_OBSERVED", "OBSERVED_MATCH", "OBSERVED_EFFECT", "DIVERGENT", "OBSERVATION_UNKNOWN"]},
    "observation_ref": {"type": ["string", "null"]},
    "reconciliation_state": {"enum": ["MATCH", "DIVERGENT", "GOVERNANCE_BYPASS", "OBSERVATION_UNKNOWN", "UNRESOLVED", "NOT_APPLICABLE"]},
    "successor_transition_id": {"type": ["string", "null"]},
    "previous_receipt_ref": {"type": ["string", "null"]}
  }
}
