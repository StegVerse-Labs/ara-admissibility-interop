{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/ara-admissibility-interop/schemas/governed-transition-envelope.v1.json",
  "title": "StegGate Governed Transition Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "transition",
    "topology",
    "origin_context",
    "candidate_binding",
    "authority_chain",
    "assurance",
    "coverage",
    "gate_path"
  ],
  "properties": {
    "schema_version": {"const": "steggate.governed-transition-envelope.v1"},
    "protocol_version": {"const": "steggate.transition.v1"},
    "transition": {"$ref": "transition.v1.json"},
    "topology": {"enum": ["local", "inline", "split", "deferred_review", "organizational", "federated", "chained"]},
    "origin_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_id", "origin_kind"],
      "properties": {
        "origin_id": {"type": "string", "minLength": 1},
        "origin_kind": {"enum": ["stegverse_node", "organization", "service", "agent", "device", "gateway", "other"]},
        "origin_key_ref": {"type": "string", "minLength": 1}
      }
    },
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization_profile", "hash_alg", "candidate_hash"],
      "properties": {
        "canonicalization_profile": {"type": "string", "minLength": 1},
        "canonicalizer_build": {"type": "string", "minLength": 1},
        "hash_alg": {"enum": ["sha-256", "sha-384"]},
        "candidate_hash": {"type": "string", "pattern": "^sha(256|384):[0-9a-f]+$"},
        "intent_binding_ref": {"type": "string", "minLength": 1},
        "commit_candidate_hash": {"type": "string", "pattern": "^sha(256|384):[0-9a-f]+$"}
      }
    },
    "authority_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_ref", "authority_hash", "authority_profile"],
        "properties": {
          "authority_ref": {"type": "string", "minLength": 1},
          "authority_hash": {"type": "string", "minLength": 1},
          "authority_profile": {"type": "string", "minLength": 1},
          "grantor_ref": {"type": "string", "minLength": 1},
          "delegate_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_snapshot_ref": {"type": "string", "minLength": 1},
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_profile", "trust_anchor_refs"],
      "properties": {
        "requested_profile": {"enum": ["L0", "L1", "L2", "L3"]},
        "achieved_profile": {"enum": ["L0", "L1", "L2", "L3"]},
        "trust_anchor_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "claim_class"],
      "properties": {
        "mode": {"enum": ["credential_brokered", "target_verified_admission", "reconciled", "declared_out_of_scope"]},
        "claim_class": {"enum": ["structural", "observational", "none"]},
        "reconciliation_ref": {"type": "string", "minLength": 1}
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "target_support"],
      "properties": {
        "idempotency_key": {"type": "string", "minLength": 1},
        "target_support": {"enum": ["supported", "unsupported", "unknown"]}
      }
    },
    "gate_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateway_id", "input_authority_hash", "effective_authority_hash", "broadened", "decision"],
        "properties": {
          "gateway_id": {"type": "string", "minLength": 1},
          "input_authority_hash": {"type": "string", "minLength": 1},
          "effective_authority_hash": {"type": "string", "minLength": 1},
          "narrowing_changed": {"type": "boolean"},
          "narrowed_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "broadened": {"const": false},
          "decision": {"enum": ["ALLOW", "DENY", "REVIEW", "FAIL_CLOSED"]},
          "receipt_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "critical_extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
