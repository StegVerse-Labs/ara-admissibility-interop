{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/ara-admissibility-interop/schemas/gateway-discovery.v1.json",
  "title": "StegGate Gateway Discovery v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gateway_id",
    "protocol_versions",
    "decision_states",
    "canonicalization_profiles",
    "identity_profiles",
    "authority_profiles",
    "assurance_profiles",
    "trust_anchor_refs",
    "bindings"
  ],
  "properties": {
    "schema_version": {"const": "steggate.gateway-discovery.v1"},
    "gateway_id": {"type": "string", "minLength": 1},
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^steggate\\.[a-z0-9._-]+\\.v[0-9]+$"}
    },
    "decision_states": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["ALLOW", "DENY", "REVIEW", "FAIL_CLOSED"]}
    },
    "canonicalization_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "identity_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assurance_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["L0", "L1", "L2", "L3"]}
    },
    "trust_anchor_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"enum": ["https", "local_ipc", "unix_socket", "named_pipe", "queue", "other"]},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "max_chain_depth": {"type": "integer", "minimum": 1, "maximum": 32},
    "critical_extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
