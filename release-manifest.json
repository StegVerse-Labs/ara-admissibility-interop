{
  "schema_version": "0.9.0",
  "repository": "StegVerse-Labs/ara-admissibility-interop",
  "candidate": "0.2.0-release-candidate",
  "status": "governed-publication-release-candidate",
  "primary_docs": {
    "docs_index": "docs/index.md",
    "docs_config": "docs/_config.yml",
    "version": "VERSION",
    "changelog": "CHANGELOG.md",
    "readiness": "docs/release-readiness.md",
    "checklist": "docs/release-checklist.md",
    "release_note": "docs/release-note-0.2.0-rc.md",
    "dependency_policy": "docs/dependency-policy.md",
    "optional_strict_validation": "docs/optional-strict-validation.md",
    "validation_guide": "docs/validation-report-guide.md",
    "artifact_retention": "docs/workflow-artifact-retention.md",
    "governed_publication": "docs/governed-publication.md",
    "publication_status": "docs/publication-status.md",
    "publication_evidence_verification": "docs/publication-evidence-verification.md",
    "release_evidence_decision": "docs/release-evidence-decision.md",
    "mirror_handoff": "docs/ARA_ADMISSIBILITY_INTEROP_MIRROR_HANDOFF.md"
  },
  "docs_site": {
    "entrypoint": "docs/index.md",
    "built_entrypoint": "_site/index.html",
    "config": "docs/_config.yml",
    "mode": "jekyll-built-github-pages",
    "requires_build_step": true,
    "build_action": "actions/jekyll-build-pages@v1",
    "build_output": "_site",
    "publishing": {
      "canonical_workflow": ".github/workflows/docs-pages.yml",
      "ios_safe_workflow": "iosnoperiod/github/workflows/docs-pages.yml",
      "manual_publish_required": false,
      "publication_manifest": "publication-manifest.json",
      "gate": "tools/check_publication_gate.py",
      "gate_tests": "tools/test_publication_gate.py",
      "status_generator": "tools/generate_publication_status.py",
      "receipt_generator": "tools/generate_publication_receipt.py",
      "receipt_schema": "publication/publication-receipt.schema.json",
      "evidence_verifier": "tools/verify_publication_evidence.py",
      "release_evaluator": "tools/evaluate_release_evidence.py"
    }
  },
  "dependency_policy": {
    "baseline": "dependency-free",
    "required_dependencies": [],
    "optional_dependencies": [
      {
        "name": "jsonschema",
        "tool": "tools/validate_with_jsonschema_optional.py",
        "absent_behavior": "skip-with-exit-zero",
        "present_behavior": "full-json-schema-validation"
      }
    ],
    "prohibited_behavior": [
      "installing packages during validation without explicit user action",
      "requiring network access during validation",
      "failing default CI because an optional package is missing",
      "silently replacing dependency-free checks with dependency-backed checks"
    ]
  },
  "validation": {
    "command": "python3 tools/generate_validation_report.py",
    "machine_readable_output": "status/generated-status.json",
    "human_readable_output": "status/validation-report.md",
    "expected_state": "self-check-pass",
    "optional_strict_command": "python3 tools/validate_with_jsonschema_optional.py",
    "optional_strict_dependency": "jsonschema",
    "optional_strict_absent_behavior": "skip-with-exit-zero",
    "publication_commands": [
      "python3 tools/check_publication_gate.py",
      "python3 tools/test_publication_gate.py",
      "python3 tools/check_workflow_parity.py",
      "python3 tools/generate_publication_status.py",
      "python3 tools/generate_publication_receipt.py",
      "python3 tools/test_publication_evidence_verifier.py",
      "python3 tools/test_release_evidence_evaluator.py"
    ],
    "deployed_evidence_command": "python3 tools/evaluate_release_evidence.py --artifact-root _site --identity-file status/deployed-identity.json --live-root-file status/deployed-live-root.html --require-public-review-allow",
    "artifact_retention": {
      "canonical_workflow": ".github/workflows/repo-check.yml",
      "ios_safe_workflow": "iosnoperiod/github/workflows/repo-check.yml",
      "generated_status_artifact": "generated-status",
      "validation_report_artifact": "validation-report",
      "publication_status_artifact": "publication-status",
      "publication_receipt_artifact": "publication-receipt",
      "deployed_publication_evidence_artifact": "deployed-publication-evidence",
      "release_evidence_decision_json": "status/release-evidence-decision.json",
      "release_evidence_decision_markdown": "status/release-evidence-decision.md",
      "captured_live_root": "status/deployed-live-root.html",
      "captured_deployment_identity": "status/deployed-identity.json",
      "retained_built_site": "_site",
      "manual_artifact_retention_required": false
    }
  },
  "release_evidence": {
    "decision_type": "governed-release-evidence-decision",
    "evaluator": "tools/evaluate_release_evidence.py",
    "independent_verifier": "tools/verify_publication_evidence.py",
    "public_review_fail_closed": true,
    "requires_built_artifact": true,
    "requires_captured_live_root": true,
    "requires_captured_deployment_identity": true,
    "automatic_stable_authorization": false,
    "stable_tag_creation": "maintainer-authorized-only"
  },
  "workflows": {
    "repo_check_canonical_path": ".github/workflows/repo-check.yml",
    "repo_check_ios_safe_path": "iosnoperiod/github/workflows/repo-check.yml",
    "docs_pages_canonical_path": ".github/workflows/docs-pages.yml",
    "docs_pages_ios_safe_path": "iosnoperiod/github/workflows/docs-pages.yml",
    "workflow_parity_check": "tools/check_workflow_parity.py",
    "summary_output": true,
    "manual_docs_publish_required": false,
    "manual_artifact_retention_required": false,
    "artifact_upload": "automated",
    "built_entrypoint_verification": "required",
    "deployment_url_verification": "required",
    "release_evidence_decision": "required",
    "stable_tag_blocked_until_live_verification": true
  },
  "claims": [
    "Independent interoperability prototype for evaluating ARA-style artifacts as commitment candidates.",
    "Dependency-free validation path for local schemas, examples, evaluator fixtures, and negative fixtures.",
    "Optional stricter JSON Schema validation path when jsonschema is installed.",
    "Jekyll-built GitHub Pages documentation site with verified index.html entry point.",
    "Manifest-governed automated docs publishing workflow for GitHub Pages.",
    "Fail-closed publication gate with executable negative tests.",
    "Automated validation, publication-status, publication-receipt, and release-evidence artifact retention.",
    "Hash-bound publication receipt covering the manifest and published file inventory.",
    "Independent retained-evidence verification for the built artifact, deployment identity, and captured live root.",
    "Bounded public-review and stable-release evidence decisions without automatic stable-release authorization.",
    "Commit-time standing-result examples for ALLOW, DENY, and FAIL-CLOSED."
  ],
  "non_claims": [
    "No upstream ARA endorsement is claimed.",
    "No certification of external artifacts is claimed.",
    "No production Standing Proof Engine behavior is claimed.",
    "No journal, conference, lab, platform, or repository acceptance is claimed.",
    "No execution authority for external systems is claimed.",
    "No canonical doctrine status is claimed.",
    "No independent review, clinical validation, or regulatory authorization is claimed.",
    "No required full JSON Schema conformance is claimed when the optional dependency is absent.",
    "No stable release is automatically authorized by a passing public-review evidence decision."
  ],
  "release_gate": {
    "repo_check_workflow_verified": false,
    "pages_workflow_verified": false,
    "https_deployment_url_verified": true,
    "built_entrypoint_verified": false,
    "live_root_page_verified": false,
    "deployed_publication_receipt_verified": false,
    "stable_release_authorized": false
  },
  "next_version_candidates": [
    "make full JSON Schema validation required if dependency policy changes",
    "external example package with explicit permission",
    "richer evaluator semantics beyond the current stub",
    "optional governed Site mirroring after Site handoff review"
  ]
}
