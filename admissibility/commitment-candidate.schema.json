{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/ara-admissibility-interop/schemas/commitment-candidate.schema.json",
  "title": "ARA Admissibility Commitment Candidate",
  "description": "A structured request presenting an ARA-style artifact or artifact-derived claim for commit-time standing evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "transition_id",
    "artifact_reference",
    "requested_action",
    "actor",
    "target",
    "scope",
    "claim_boundary",
    "policy_reference",
    "evidence_references",
    "execution_context",
    "validity_window",
    "recoverability_profile"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for this commitment candidate."
    },
    "transition_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for the proposed boundary crossing."
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "uri"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_type": {
          "type": "string",
          "enum": ["ara-style-artifact", "ara-package", "research-artifact", "other"]
        },
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "type": "string" },
        "digest_algorithm": { "type": "string" }
      }
    },
    "requested_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "description"],
      "properties": {
        "action_type": {
          "type": "string",
          "enum": [
            "cite",
            "publish",
            "accept",
            "execute",
            "integrate",
            "rely-upon",
            "evaluate",
            "other"
          ]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_type"],
      "properties": {
        "actor_id": { "type": "string", "minLength": 1 },
        "actor_type": {
          "type": "string",
          "enum": ["human", "agent", "organization", "repository", "system", "unknown"]
        },
        "display_name": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "target_type"],
      "properties": {
        "target_id": { "type": "string", "minLength": 1 },
        "target_type": {
          "type": "string",
          "enum": ["claim", "paper", "repository", "system", "dataset", "execution-environment", "publication", "other"]
        },
        "description": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scope_id", "description"],
      "properties": {
        "scope_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "non_claims"],
      "properties": {
        "claims": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "non_claims": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "policy_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "uri"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "type": "string" },
        "digest_algorithm": { "type": "string" }
      }
    },
    "delegation_reference": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "delegation_id": { "type": "string", "minLength": 1 },
        "uri": { "type": "string" },
        "delegated_by": { "type": "string" },
        "delegated_to": { "type": "string" },
        "scope": { "type": "string" }
      }
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_type", "uri"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "evidence_type": {
            "type": "string",
            "enum": ["logic", "code", "trace", "dataset", "review", "summary", "receipt", "other"]
          },
          "uri": { "type": "string", "minLength": 1 },
          "digest": { "type": "string" },
          "digest_algorithm": { "type": "string" }
        }
      }
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": true,
      "required": ["context_id", "evaluated_at"],
      "properties": {
        "context_id": { "type": "string", "minLength": 1 },
        "evaluated_at": { "type": "string", "format": "date-time" }
      }
    },
    "validity_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_before", "not_after"],
      "properties": {
        "not_before": { "type": "string", "format": "date-time" },
        "not_after": { "type": "string", "format": "date-time" }
      }
    },
    "recoverability_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recoverability_class", "description"],
      "properties": {
        "recoverability_class": {
          "type": "string",
          "enum": ["reversible", "remediable", "quarantineable", "reconstructable-only", "irreversible", "unknown"]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
